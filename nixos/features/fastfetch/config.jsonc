{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "$1                      ,\n ,-.       _,---._ __  / \\\n/  )    .-'       `./ /   \\\n(  (   ,'            `/    /|\n \\  `-\"             \\ '\\  / |\n  `.              ,  \\ \\ /  |\n   /`.          ,'-`----Y   |\n  (            ;        |   '\n  |  ,-.    ,-'         |  /\n  |  | (   |    luynar  | /\n  )  |  \\  `.___________|/\n  `--'   `--'",
    "color": {
      "1": "#{{ primary.hex }}"
    },
    "padding": {
      "top": 1
    }
  },
  "display": {
    "separator": ": "
  },
  "modules": [
    "title",
    "break",
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "wm",
      "key": "WM"
    },
    {
      "type": "shell",
      "key": "SH"
    },
    "break",
    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "hideType": "integrated"
    },
    {
      "type": "memory",
      "key": "RAM"
    },
    "break",
    "colors"
  ]
}
